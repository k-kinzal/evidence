{
  "$defs": {
    "Hit": {
      "description": "One search hit.",
      "properties": {
        "field": {
          "description": "Where the match was found (`id`, `title`, `tags`, `description`, `path`, `content`).",
          "type": "string"
        },
        "id": {
          "description": "Evidence id.",
          "type": "string"
        },
        "kind": {
          "description": "Kind.",
          "type": "string"
        },
        "line": {
          "description": "Matching line (content matches).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "score": {
          "description": "Relevance score (higher is better).",
          "format": "double",
          "type": "number"
        },
        "snippet": {
          "description": "Snippet.",
          "type": "string"
        },
        "subject": {
          "description": "Subject path.",
          "type": "string"
        },
        "title": {
          "description": "Title.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "subject",
        "field",
        "snippet",
        "score"
      ],
      "type": "object"
    }
  },
  "$id": "https://evidence-cli.github.io/schemas/output/search.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "hits": {
      "items": {
        "$ref": "#/$defs/Hit"
      },
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "hits"
  ],
  "title": "evidence --json search",
  "type": "object"
}
