{
  "$id": "https://evidence-cli.github.io/schemas/output/remove.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "removed": {
      "description": "Result of [`remove`].",
      "properties": {
        "files": {
          "description": "Removed files.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "Evidence id.",
          "type": "string"
        },
        "kept_outside": {
          "description": "Subject left in place because it lies outside the project.",
          "type": [
            "string",
            "null"
          ]
        },
        "orphaned": {
          "description": "Dependents that now reference a missing evidence.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "files",
        "orphaned"
      ],
      "type": "object"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "removed"
  ],
  "title": "evidence --json remove",
  "type": "object"
}
