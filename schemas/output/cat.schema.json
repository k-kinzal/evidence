{
  "$defs": {
    "DirEntry": {
      "description": "One entry of a directory snapshot.",
      "properties": {
        "directory": {
          "description": "Whether the entry is a directory.",
          "type": "boolean"
        },
        "name": {
          "description": "File or directory name.",
          "type": "string"
        },
        "snapshot": {
          "description": "Snapshot id of the entry.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "directory",
        "snapshot"
      ],
      "type": "object"
    }
  },
  "$id": "https://evidence-cli.github.io/schemas/output/cat.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "tree": {
      "items": {
        "$ref": "#/$defs/DirEntry"
      },
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "tree"
  ],
  "title": "evidence --json cat (directory snapshots)",
  "type": "object"
}
