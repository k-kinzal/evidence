{
  "$defs": {
    "MemberAction": {
      "description": "What happened to a member.",
      "oneOf": [
        {
          "const": "added",
          "description": "A new entry: its evidence file was created.",
          "type": "string"
        },
        {
          "const": "moved",
          "description": "The entry's subject path changed: subject and evidence file were moved.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "The entry left the list and `on_removed = \"delete\"`: the pair was deleted.",
          "type": "string"
        },
        {
          "const": "kept",
          "description": "The entry left the list, but other evidence depends on the member, so it stays.",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "The member could not be created, moved, or removed (the path is taken, an I/O error).",
          "type": "string"
        }
      ]
    },
    "MemberChange": {
      "description": "What `evidence update` did to a member of a list.",
      "properties": {
        "action": {
          "$ref": "#/$defs/MemberAction",
          "description": "What happened."
        },
        "evid": {
          "description": "The member's evidence file, relative to the project root.",
          "type": "string"
        },
        "key": {
          "description": "Key of the entry.",
          "type": "string"
        },
        "message": {
          "description": "Why, for `kept` and `skipped`.",
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "description": "Id of the parent.",
          "type": "string"
        }
      },
      "required": [
        "parent",
        "key",
        "action",
        "evid"
      ],
      "type": "object"
    },
    "Operation": {
      "description": "What a run does.",
      "oneOf": [
        {
          "const": "fetch",
          "description": "Runs `[source]`.",
          "type": "string"
        },
        {
          "const": "transform",
          "description": "Runs `[transform]`.",
          "type": "string"
        },
        {
          "const": "generate",
          "description": "Runs `[generator]`.",
          "type": "string"
        }
      ]
    },
    "RunReport": {
      "description": "What happened to one pair.",
      "properties": {
        "duration_ms": {
          "description": "Duration.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "Evidence id.",
          "type": "string"
        },
        "message": {
          "description": "Error or note.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "$ref": "#/$defs/Operation",
          "description": "Operation."
        },
        "previous": {
          "description": "Previous snapshot.",
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "description": "Why it ran.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "snapshot": {
          "description": "New snapshot.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Result (`None` in a dry run)."
        }
      },
      "required": [
        "id",
        "operation",
        "reasons",
        "status",
        "duration_ms"
      ],
      "type": "object"
    },
    "RunStatus": {
      "description": "Result of a run.",
      "oneOf": [
        {
          "const": "changed",
          "description": "A new snapshot was accepted.",
          "type": "string"
        },
        {
          "const": "unchanged",
          "description": "The run succeeded and the content did not change.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The run, schema validation, or verification failed; the previous snapshot was kept.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://evidence-cli.github.io/schemas/output/update.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "update": {
      "description": "Result of [`update`].",
      "properties": {
        "affected": {
          "description": "Pairs downstream of a change that were not re-run (need review or an update).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dry_run": {
          "description": "Whether this was a dry run.",
          "type": "boolean"
        },
        "members": {
          "description": "Members of lists that were added, moved, or removed.",
          "items": {
            "$ref": "#/$defs/MemberChange"
          },
          "type": "array"
        },
        "runs": {
          "description": "Runs in execution order.",
          "items": {
            "$ref": "#/$defs/RunReport"
          },
          "type": "array"
        }
      },
      "required": [
        "dry_run",
        "runs",
        "affected"
      ],
      "type": "object"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "update"
  ],
  "title": "evidence --json update",
  "type": "object"
}
