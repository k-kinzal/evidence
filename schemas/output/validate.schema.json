{
  "$defs": {
    "Diagnostic": {
      "description": "A problem found in an evidence file, configuration, or subject.",
      "properties": {
        "code": {
          "description": "Stable machine-readable code (e.g. `schema`, `unknown-ref`, `cycle`).",
          "type": "string"
        },
        "file": {
          "description": "File the diagnostic refers to.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based line in `file`, when known.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "pointer": {
          "description": "JSON Pointer to the offending value, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "description": "Severity."
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "type": "object"
    },
    "Severity": {
      "description": "Severity of a diagnostic.",
      "oneOf": [
        {
          "const": "warning",
          "description": "Informational; never fails a command.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Invalid input; fails validation.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://evidence-cli.github.io/schemas/output/validate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "diagnostics"
  ],
  "title": "evidence --json validate",
  "type": "object"
}
