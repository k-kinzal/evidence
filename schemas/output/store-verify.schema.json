{
  "$id": "https://evidence-cli.github.io/schemas/output/store-verify.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "verify": {
      "description": "Result of [`Project::verify_store`].",
      "properties": {
        "checked": {
          "description": "Objects checked.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "corrupt": {
          "description": "Ids of objects whose content no longer matches their id.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "checked",
        "corrupt"
      ],
      "type": "object"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "verify"
  ],
  "title": "evidence --json store verify",
  "type": "object"
}
